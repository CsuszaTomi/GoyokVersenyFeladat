<Window x:Class="GoyokVersenyFeladat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MineScript IDE"
        MinWidth="700" MinHeight="480"
        Width="1100" Height="680"
        Background="#1B1E26">

    <Window.Resources>
        <!-- Színek -->
        <SolidColorBrush x:Key="BgMain"      Color="#1B1E26"/>
        <SolidColorBrush x:Key="BgPanel"     Color="#22262E"/>
        <SolidColorBrush x:Key="BgToolbar"   Color="#292D38"/>
        <SolidColorBrush x:Key="BorderColor" Color="#363B4A"/>
        <SolidColorBrush x:Key="FgMain"      Color="White"/>
        <SolidColorBrush x:Key="FgDim"       Color="#6A738A"/>
        <SolidColorBrush x:Key="Accent"      Color="#5B8AF5"/>
        <SolidColorBrush x:Key="BlockCmd"    Color="#2E6098"/>
        <SolidColorBrush x:Key="BlockCtrl"   Color="#6A3F96"/>
        <SolidColorBrush x:Key="BlockVal"    Color="#2E7858"/>
        <SolidColorBrush x:Key="GreenBtn"    Color="#3A7A3A"/>

        <!-- Alap gomb stílus -->
        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Foreground"       Value="{StaticResource FgMain}"/>
            <Setter Property="Background"       Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="10,4"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontFamily"       Value="San Francisco"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zöld (Run) gomb -->
        <Style x:Key="RunBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background"  Value="#3A7A3A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- Debug gomb -->
        <Style x:Key="DebugBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background"  Value="#7A6020"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- Stop gomb -->
        <Style x:Key="StopBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background"  Value="#7A2020"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="White"/>
        </Style>

        <!-- Panel fejléc szöveg -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground"       Value="{StaticResource FgDim}"/>
            <Setter Property="FontSize"         Value="10"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="FontFamily"       Value="Inter"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Paletta blokk stílus -->
        <Style x:Key="PaletteBlock" TargetType="Border">
            <Setter Property="CornerRadius"  Value="6"/>
            <Setter Property="Padding"       Value="8,6"/>
            <Setter Property="Margin"        Value="0,0,0,4"/>
            <Setter Property="Cursor"        Value="Hand"/>
        </Style>

        <!-- Kategória felirat -->
        <Style x:Key="CatLabel" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontFamily"  Value="Inter"/>
            <Setter Property="Margin"      Value="4,0,0,5"/>
        </Style>

        <!-- ScrollViewer stílus (vékony scrollbar) -->
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Kód nézet sor -->
        <Style x:Key="CodeLine" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Foreground"  Value="{StaticResource FgMain}"/>
            <Setter Property="Margin"      Value="0,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- IDE terület -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════
             TOOLBAR
        ════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0">

                <TextBlock Text="MineScript IDE"
                           Foreground="{StaticResource Accent}"
                           FontFamily="Inter"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <Rectangle Width="1" Height="22"
                           Fill="{StaticResource BorderColor}"
                           Margin="0,0,8,0"/>

                <Button Content="▶  Futtatás" Style="{StaticResource RunBtn}"   Margin="0,0,6,0"/>
                <Button Content="⬛  Debug"   Style="{StaticResource DebugBtn}" Margin="0,0,6,0"/>
                <Button Content="■  Stop"    Style="{StaticResource StopBtn}"   Margin="0,0,6,0"/>

                <Rectangle Width="1" Height="22"
                           Fill="{StaticResource BorderColor}"
                           Margin="0,0,8,0"/>

                <Button Content="Törlés"  

                        FontWeight="SemiBold"
                        Style="{StaticResource BaseBtn}"/>

                <!-- jobb oldal -->
                <TextBlock x:Name="StatusBar"
                           Text="Készen áll"
                           Foreground="{StaticResource FgDim}"
                           FontFamily="Consolas"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════
             IDE TERÜLET  (3 oszlop: paletta | vászon | kód)
             GridSplitter-ekkel reszponzív
        ════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="140" MaxWidth="320"/>
                <ColumnDefinition Width="4"/>
                <!-- splitter -->
                <ColumnDefinition Width="*"   MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <!-- splitter -->
                <ColumnDefinition Width="300" MinWidth="180" MaxWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- ─── PALETTA ─── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- fejléc -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BgToolbar}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0">
                        <TextBlock Text="BLOKKOK" Style="{StaticResource PanelTitle}"/>
                    </Border>

                    <!-- blokk lista -->
                    <ScrollViewer Grid.Row="1" Padding="8,10,8,10">
                        <StackPanel>

                            <!-- Parancs kategória -->
                            <TextBlock Text="PARANCS" Style="{StaticResource CatLabel}"
                                       Foreground="#6AACDB"/>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCmd}">
                                <TextBlock FontFamily="Inter" FontSize="11"
                                           FontWeight="Medium" Foreground="White"
                                           Text="● step_forward"/>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCmd}">
                                <TextBlock FontFamily="Inter" FontSize="11"
                                           FontWeight="Medium" Foreground="White"
                                           Text="● turn_by"/>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCmd}">
                                <TextBlock FontFamily="Inter" FontSize="11"
                                           FontWeight="Medium" Foreground="White"
                                           Text="● mine_here"/>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCmd}">
                                <TextBlock FontFamily="Inter" FontSize="11"
                                           FontWeight="Medium" Foreground="White"
                                           Text="● print"/>
                            </Border>

                            <!-- Vezérlő kategória -->
                            <TextBlock Text="VEZÉRLŐ" Style="{StaticResource CatLabel}"
                                       Foreground="#B07FE0" Margin="4,10,0,5"/>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCtrl}">
                                <TextBlock FontFamily="Inter" FontSize="11"
                                           FontWeight="Medium" Foreground="White"
                                           Text="● if"/>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCtrl}">
                                <TextBlock FontFamily="Inter" FontSize="11"
                                           FontWeight="Medium" Foreground="White"
                                           Text="● while"/>
                            </Border>

                            <!-- Érték kategória -->
                            <TextBlock Text="ÉRTÉK" Style="{StaticResource CatLabel}"
                                       Foreground="#5AC89A" Margin="4,10,0,5"/>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockVal}">
                                <TextBlock FontFamily="Inter" FontSize="11"
                                           FontWeight="Medium" Foreground="White"
                                           Text="● set"/>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockVal}">
                                <TextBlock FontFamily="Inter" FontSize="11"
                                           FontWeight="Medium" Foreground="White"
                                           Text="● isThere"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- GridSplitter 1 -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderColor}"
                          Cursor="SizeWE"/>

            <!-- ─── BLOKK VÁSZON ─── -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgMain}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- fejléc -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BgToolbar}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0">
                        <TextBlock Text="BLOKK SZERKESZTŐ" Style="{StaticResource PanelTitle}"/>
                    </Border>

                    <!-- üres állapot -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Path Data="M3,10 H33 V19 H3 Z M9,22 H27 V29 H9 Z"
                              Fill="{StaticResource BlockCtrl}"
                              Opacity="0.45"
                              Stretch="Uniform"
                              Width="48" Height="48"
                              Margin="0,0,0,10"/>
                        <TextBlock Text="Húzz blokkot a palettáról"
                                   Foreground="{StaticResource FgDim}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- ide kerül futásidőben a blokk lista (ItemsControl / Canvas) -->
                    <ScrollViewer Grid.Row="1"
                                  x:Name="BlockCanvas"
                                  AllowDrop="True"
                                  Padding="16"
                                  VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <!-- GridSplitter 2 -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderColor}"
                          Cursor="SizeWE"/>

            <!-- ─── KÓD NÉZET ─── -->
            <Border Grid.Column="4"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- fejléc -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BgToolbar}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0">
                        <Grid>
                            <TextBlock Text="FORRÁSKÓD" Style="{StaticResource PanelTitle}"/>
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BgMain}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="5,2">
                                <TextBlock Text="csak olvasható"
                                           FontFamily="Segoe UI"
                                           FontSize="9"
                                           Foreground="{StaticResource FgDim}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- kód terület -->
                    <ScrollViewer Grid.Row="1"
                                  Padding="14,12"
                                  Background="{StaticResource BgMain}">
                        <StackPanel x:Name="CodeView">
                            <!-- ide generálódnak a sorok kódból -->
                            <TextBlock Style="{StaticResource CodeLine}">
                                <Run Foreground="#6A738A" FontStyle="Italic"># MineScript forráskód</Run>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
