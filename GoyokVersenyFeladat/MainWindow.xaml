<Window x:Class="GoyokVersenyFeladat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MineScript IDE"
        MinWidth="700" MinHeight="520"
        Width="1100" Height="740"
        Loaded="Window_Loaded"
        Background="#1B1E26">

    <Window.Resources>
        <SolidColorBrush x:Key="BgMain"      Color="#1B1E26"/>
        <SolidColorBrush x:Key="BgPanel"     Color="#22262E"/>
        <SolidColorBrush x:Key="BgToolbar"   Color="#292D38"/>
        <SolidColorBrush x:Key="BorderColor" Color="#363B4A"/>
        <SolidColorBrush x:Key="FgMain"      Color="White"/>
        <SolidColorBrush x:Key="FgDim"       Color="#6A738A"/>
        <SolidColorBrush x:Key="Accent"      Color="#5B8AF5"/>
        <SolidColorBrush x:Key="BlockCmd"    Color="#2E6098"/>
        <SolidColorBrush x:Key="BlockCtrl"   Color="#6A3F96"/>
        <SolidColorBrush x:Key="BlockVal"    Color="#2E7858"/>
        <SolidColorBrush x:Key="GreenBtn"    Color="#3A7A3A"/>

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Foreground"       Value="{StaticResource FgMain}"/>
            <Setter Property="Background"       Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="10,4"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontFamily"        Value="San Francisco"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <!-- ÚJ: letiltott gomb halványabb -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RunBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background"  Value="#3A7A3A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <Style x:Key="DebugBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background"  Value="#7A6020"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <Style x:Key="StopBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background"  Value="#7A2020"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="White"/>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource FgDim}"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="FontFamily"        Value="Inter"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PaletteBlock" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding"      Value="8,6"/>
            <Setter Property="Margin"       Value="0,0,0,4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>

        <Style x:Key="CatLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="Margin"     Value="4,0,0,5"/>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="CodeLine" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Margin"     Value="0,1"/>
        </Style>

        <!-- Közös ComboBox stílus (isThere + operátorok) -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"     Value="#2A2D3A"/>
            <Setter Property="Foreground"     Value="Black"/>
            <Setter Property="BorderBrush"    Value="#4A5070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"     Value="Consolas"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="Padding"        Value="4,2"/>
        </Style>

        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#2A2D3A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3F55"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A5070"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="190" MinHeight="100"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0"
                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0">

                <TextBlock Text="MineScript IDE"
                           Foreground="{StaticResource Accent}"
                           FontFamily="Inter"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <Rectangle Width="1" Height="22"
                           Fill="{StaticResource BorderColor}"
                           Margin="0,0,8,0"/>

                <Button x:Name="RunButton" Content="▶  Futtatás" Style="{StaticResource RunBtn}" Margin="0,0,6,0" Click="Run_Click"/>
                <Button x:Name="DebugButton" Content="🐞  Debug" Style="{StaticResource DebugBtn}" Margin="0,0,6,0" Click="Debug_Click"/>
                <Button x:Name="StepButton" Content="⏭  Lépés" Style="{StaticResource DebugBtn}" Margin="0,0,6,0" Click="Step_Click"/>
                <Button x:Name="StopButton" Content="■  Stop" Style="{StaticResource StopBtn}" Margin="0,0,6,0" Click="Stop_Click"/>

                <Rectangle Width="1" Height="22"
                           Fill="{StaticResource BorderColor}"
                           Margin="0,0,8,0"/>

                <Button Content="Törlés" FontWeight="SemiBold"
                        Style="{StaticResource BaseBtn}"/>

                <!-- ÚJ: szimulátor ablak, napló megnyitása és futtatási sebesség -->
                <Button Content="🤖  Szimulátor" Style="{StaticResource BaseBtn}" Margin="6,0,0,0" Click="Robot_Click"/>
                <Button Content="📄  Napló" Style="{StaticResource BaseBtn}" Margin="6,0,0,0" Click="Log_Click"/>
                <TextBlock Text="Sebesség" Foreground="{StaticResource FgDim}" FontSize="11"
                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                <Slider x:Name="SpeedSlider" Minimum="20" Maximum="1000" Value="750" Width="100"
                        VerticalAlignment="Center" ToolTip="Futtatás sebessége (jobbra: gyorsabb)"
                        ValueChanged="SpeedSlider_ValueChanged"/>

                <TextBlock x:Name="StatusBar"
                           Text="Készen áll"
                           Foreground="{StaticResource FgDim}"
                           FontFamily="Consolas"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- IDE TERÜLET -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="140" MaxWidth="320"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"   MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="300" MinWidth="180" MaxWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- PALETTA -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BgToolbar}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0">
                        <TextBlock Text="BLOKKOK" Style="{StaticResource PanelTitle}"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="8,10,8,10">
                        <StackPanel>

                            <TextBlock Text="PARANCS" Style="{StaticResource CatLabel}"
                                       Foreground="#6AACDB"/>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCmd}"
                                    PreviewMouseMove="Block_MouseMove"
                                    Tag="step_forward">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Inter" FontSize="11"
                                               FontWeight="Medium" Foreground="White"
                                               Text="● step_forward" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox Width="40" Text="1"
                                             Background="#2A2D3A" Foreground="White"
                                             BorderBrush="#4A5070" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCmd}"
                                    MouseMove="Block_MouseMove"
                                    Tag="turn_by">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Inter" FontSize="11"
                                               FontWeight="Medium" Foreground="White"
                                               Text="● turn_by" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox Width="40" Text="1"
                                             Background="#2A2D3A" Foreground="White"
                                             BorderBrush="#4A5070" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCmd}"
                                    MouseMove="Block_MouseMove"
                                    Tag="mine_here">
                                <TextBlock FontFamily="Inter" FontSize="11"
                                           FontWeight="Medium" Foreground="White"
                                           Text="● mine_here"/>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCmd}"
                                    MouseMove="Block_MouseMove"
                                    Tag="print">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Inter" FontSize="11"
                                               FontWeight="Medium" Foreground="White"
                                               Text="● print" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox Width="72" Text="x"
                                             Background="#2A2D3A" Foreground="White"
                                             BorderBrush="#4A5070" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="VEZÉRLŐ" Style="{StaticResource CatLabel}"
                                       Foreground="#B07FE0" Margin="4,10,0,5"/>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCtrl}"
                                    MouseMove="Block_MouseMove"
                                    Tag="if">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Inter" FontSize="11"
                                               FontWeight="Medium" Foreground="White"
                                               Text="● if" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox Width="52" Text="x"
                                             Background="#2A2D3A" Foreground="White"
                                             BorderBrush="#4A5070" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                                    <ComboBox Width="52" Margin="4,0"
                                              Style="{StaticResource DarkCombo}">
                                        <ComboBox.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"     Color="#2A2D3A"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Black"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#4A5070"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                        </ComboBox.Resources>
                                        <ComboBoxItem Content="=="  IsSelected="True" Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="!="  Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="&lt;"  Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="&lt;=" Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="&gt;"  Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="&gt;=" Style="{StaticResource DarkComboItem}"/>
                                    </ComboBox>
                                    <TextBox Width="52" Text="0"
                                             Background="#2A2D3A" Foreground="White"
                                             BorderBrush="#4A5070" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockCtrl}"
                                    MouseMove="Block_MouseMove"
                                    Tag="while">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Inter" FontSize="11"
                                               FontWeight="Medium" Foreground="White"
                                               Text="● while" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox Width="52" Text="x"
                                             Background="#2A2D3A" Foreground="White"
                                             BorderBrush="#4A5070" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                                    <ComboBox Width="52" Margin="4,0"
                                              Style="{StaticResource DarkCombo}">
                                        <ComboBox.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"     Color="#2A2D3A"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Black"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#4A5070"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                        </ComboBox.Resources>
                                        <ComboBoxItem Content="=="  IsSelected="True" Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="!="  Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="&lt;"  Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="&lt;=" Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="&gt;"  Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="&gt;=" Style="{StaticResource DarkComboItem}"/>
                                    </ComboBox>
                                    <TextBox Width="52" Text="0"
                                             Background="#2A2D3A" Foreground="White"
                                             BorderBrush="#4A5070" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ÉRTÉK" Style="{StaticResource CatLabel}"
                                       Foreground="#5AC89A" Margin="4,10,0,5"/>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockVal}"
                                    MouseMove="Block_MouseMove"
                                    Tag="set">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Inter" FontSize="11"
                                               FontWeight="Medium" Foreground="White"
                                               Text="● set" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox Width="52" Text="x"
                                             Background="#2A2D3A" Foreground="White"
                                             BorderBrush="#4A5070" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                                    <TextBlock Text="=" Foreground="#AAAACC"
                                               FontFamily="Consolas" FontSize="11"
                                               VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBox Width="64" Text="0"
                                             Background="#2A2D3A" Foreground="White"
                                             BorderBrush="#4A5070" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PaletteBlock}"
                                    Background="{StaticResource BlockVal}"
                                    MouseMove="Block_MouseMove"
                                    Tag="isThere">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Inter" FontSize="11"
                                               FontWeight="Medium" Foreground="White"
                                               Text="● isThere" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox Width="72"
                                              Style="{StaticResource DarkCombo}">
                                        <ComboBox.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"     Color="#2A2D3A"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Black"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#4A5070"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                        </ComboBox.Resources>
                                        <ComboBoxItem Content="wall"  IsSelected="True" Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="gold"  Style="{StaticResource DarkComboItem}"/>
                                        <ComboBoxItem Content="empty" Style="{StaticResource DarkComboItem}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- GridSplitter 1 -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderColor}"
                          Cursor="SizeWE"/>

            <!-- BLOKK VÁSZON -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgMain}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BgToolbar}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0">
                        <TextBlock Text="BLOKK SZERKESZTŐ" Style="{StaticResource PanelTitle}"/>
                    </Border>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Path Data="M3,10 H33 V19 H3 Z M9,22 H27 V29 H9 Z"
                              Fill="{StaticResource BlockCtrl}"
                              Opacity="0.45"
                              Stretch="Uniform"
                              Width="48" Height="48"
                              Margin="0,0,0,10"/>
                        <TextBlock Text="Húzz blokkot a palettáról"
                                   Foreground="{StaticResource FgDim}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  x:Name="BlockCanvas"
                                  AllowDrop="True"
                                  Padding="16"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BlockPanel"
                                    AllowDrop="True"
                                    Drop="BlockPanel_Drop"
                                    Background="Transparent"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- GridSplitter 2 -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderColor}"
                          Cursor="SizeWE"/>

            <!-- KÓD NÉZET -->
            <Border Grid.Column="4"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BgToolbar}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0">
                        <Grid>
                            <TextBlock Text="FORRÁSKÓD" Style="{StaticResource PanelTitle}"/>
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BgMain}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="5,2">
                                <TextBlock Text="csak olvasható"
                                           FontFamily="Segoe UI"
                                           FontSize="9"
                                           Foreground="{StaticResource FgDim}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Padding="14,12"
                                  Background="{StaticResource BgMain}">
                        <StackPanel x:Name="CodeView">
                            <TextBlock Name="CodeTextBlock" Style="{StaticResource CodeLine}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- ÚJ: VÁLTOZÓK + KONZOL (a robot szimulátor (Engine) külön ablakban nyílik meg, lásd MainWindow.Run.cs) -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{StaticResource BorderColor}" Cursor="SizeNS"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="120"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="150"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1" Padding="12,0">
                        <TextBlock Text="VÁLTOZÓK" Style="{StaticResource PanelTitle}"/>
                    </Border>
                    <ListBox x:Name="VarList" Grid.Row="1" Background="{StaticResource BgMain}"
                             BorderThickness="0" Foreground="White" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderColor}" Cursor="SizeWE"/>

            <Border Grid.Column="2" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1" Padding="12,0">
                        <TextBlock Text="KONZOL" Style="{StaticResource PanelTitle}"/>
                    </Border>
                    <TextBox x:Name="ConsoleBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                             Background="{StaticResource BgMain}" Foreground="{StaticResource FgMain}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="10,8"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>