<Window x:Class="GoyokVersenyFeladat.Engine.Engine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoyokVersenyFeladat.Engine"
        mc:Ignorable="d"
        Title="Engine" Height="450" Width="800">
    <Grid>
        <Border x:Name="Bar" Height="40" VerticalAlignment="Bottom" Background="#EEEEEE">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Fordulj balra" Click="Turn_Click" Margin="5,0"/>
                <Button Content="Előre" Click="Step_Click" Margin="5,0"/>
                <Button Content="Bányássz" Click="Mine_Click" Margin="5,0"/>
                <TextBlock x:Name="Status" Margin="15,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
