<UserControl x:Class="GoyokVersenyFeladat.Engine.Engine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="Bar" Height="40" VerticalAlignment="Bottom" Background="#EEEEEE">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Fordulj balra" Click="Turn_Click" Margin="5,0"/>
                <Button Content="Előre" Click="Step_Click" Margin="5,0"/>
                <Button Content="Bányássz" Click="Mine_Click" Margin="5,0"/>
                <TextBlock x:Name="Status" Margin="15,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>